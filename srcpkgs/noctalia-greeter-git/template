depends="greetd dbus"

post_install() {
    vlicense LICENSE
    vdoc README.md

    if [ ! -x "${DESTDIR}/usr/bin/noctalia-greeter" ]; then
        msg_error "Expected binary /usr/bin/noctalia-greeter not found.\n"
    fi
}
